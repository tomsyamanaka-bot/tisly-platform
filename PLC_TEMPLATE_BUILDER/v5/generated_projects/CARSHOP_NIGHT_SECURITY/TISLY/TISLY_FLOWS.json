    "z": "tab_e8b47429",
    "name": "Alarm Handler",
    "func": "// TiSLY PLC Builder v5.15 — Node-RED Flow Generator\n// Alarm Handler — inputs: EStop_01, Beam_01, Beam_02, Beam_03, Beam_04\nconst payload = typeof msg.payload === 'object'\n    ? msg.payload\n    : { value: msg.payload, source: msg.topic };\nmsg.alarm = {\n    device_id: '211',\n    topic: msg.topic,\n    timestamp: new Date().toISOString(),\n    payload\n};\nmsg.payload = msg.alarm;\nreturn msg;",
