    "id": "motion_fn_872c0ef8",
    "type": "function",
    "z": "tab_e8b47429",
    "name": "Motion Handler",
    "func": "// TiSLY PLC Builder v5.15 — Node-RED Flow Generator\n// Motion Handler — inputs: PIR_01, PIR_02\nconst now = Date.now();\nconst last = context.get('lastMotion') || 0;\nif (now - last < 3000) { return null; }\ncontext.set('lastMotion', now);\nmsg.motion = {\n    device_id: '211',\n    topic: msg.topic,\n    timestamp: new Date().toISOString(),\n    payload: msg.payload\n};\nmsg.payload = msg.motion;\nreturn msg;",
