# Notion API（未設定時は data/sample/ の JSON を使用）
NOTION_API_TOKEN=
NOTION_PROJECT_DB_ID=
NOTION_SITE_SURVEY_DB_ID=
NOTION_ESTIMATE_DB_ID=
NOTION_INVOICE_DB_ID=

# TOMS 設定
TOMS_COMPANY_NAME=TiSLY株式会社
TOMS_TEMPLATE_PATH=templates/TOMS標準見積フォーマット.xlsx
TOMS_INVOICE_TEMPLATE_PATH=templates/TOMS標準請求フォーマット.xlsx
TOMS_OUTPUT_DIR=output
TOMS_SAMPLE_DIR=data/sample
TOMS_INVOICE_COUNTER_PATH=data/invoice_counter.json
TOMS_BANK_INFO=○○銀行 ○○支店 普通 1234567 TiSLY株式会社

# QNAP 保存（ローカル開発時は QNAP/TOMS/ に保存）
QNAP_BASE_PATH=QNAP/TOMS
TOMS_QNAP_ENABLED=true

# メール（TOMS_SEND_EMAIL=true で有効化）
TOMS_SEND_EMAIL=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ADMIN_EMAIL=

# TiSLY Notification Platform (server/ — Phase 21-40)
TISLY_PORT=3080
TISLY_PUBLIC_URL=https://tisly.jp
# MQTT — Phase 1041–1050 (mock|real 切替)
MQTT_MODE=mock
MQTT_URL=mqtt://127.0.0.1:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=tisly

# Shelly Gen3 — Phase 1051–1060 (mock|real 切替)
SHELLY_MODE=mock
SHELLY_BASE_URL=
SHELLY_AUTH_TOKEN=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
HEARTBEAT_WARN_SEC=30
HEARTBEAT_ALARM_SEC=300

# ---------------------------------------------------------------------------
