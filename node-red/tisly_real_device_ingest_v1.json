[
    {
        "id": "rd_tab_main",
        "type": "tab",
        "label": "TiSLY Real Device Ingest v1",
        "disabled": false,
        "info": "Phase 101-120 — 統一 MQTT → HTTP ingest / heartbeat / retry"
    },
    {
        "id": "rd_mqtt_broker",
        "type": "mqtt-broker",
        "name": "TiSLY MQTT",
        "broker": "127.0.0.1",
        "port": "1883",
        "clientid": "node-red-tisly-ingest",
        "autoConnect": true,
        "usetls": false,
        "protocolVersion": "4",
        "keepalive": "60",
        "cleansession": true
    },
    {
        "id": "rd_mqtt_in",
        "type": "mqtt in",
        "z": "rd_tab_main",
        "name": "tisly/+/+/+/#",
        "topic": "tisly/+/+/+/#",
        "qos": "1",
        "datatype": "utf8",
        "broker": "rd_mqtt_broker",
        "nl": false,
        "rap": false,
        "inputs": 0,
        "x": 120,
        "y": 80,
        "wires": [["rd_fn_route"]]
    },
    {
        "id": "rd_fn_route",
        "type": "function",
        "z": "rd_tab_main",
        "name": "Route channel",
        "func": "const topic = msg.topic || \"\";\nconst parts = topic.split(\"/\");\nif (parts.length < 5 || parts[0] !== \"tisly\") return null;\nconst tenant = parts[1];\nconst site = parts[2];\nconst device = parts[3];\nconst channel = parts[4];\nmsg.tisly = { tenant, site, device, channel };\nif (channel === \"heartbeat\") return [null, msg, null];\nif (channel === \"event\") return [msg, null, null];\nif (channel === \"state\") return [null, null, msg];\nif (channel === \"recovery\") return [msg, null, null];\nreturn null;",
        "outputs": 3,
        "x": 320,
        "y": 80,
        "wires": [["rd_fn_to_unified"], ["rd_fn_heartbeat_api"], ["rd_debug_state"]]
    },
    {
        "id": "rd_fn_to_unified",
        "type": "function",
        "z": "rd_tab_main",
        "name": "→ Unified event",
        "func": "const t = msg.tisly;\nlet raw = {};\ntry { raw = typeof msg.payload === \"string\" ? JSON.parse(msg.payload) : (msg.payload || {}); } catch(e) { raw = { message: String(msg.payload) }; }\nconst evt = {\n  event_id: raw.event_id || (\"nr-\" + Date.now() + \"-\" + Math.random().toString(36).slice(2, 8)),\n  tenant_id: raw.tenant_id || t.tenant,\n  site_id: raw.site_id || t.site,\n  device_id: raw.device_id || t.device,\n  source_type: raw.source_type || \"node-red\",\n  event_type: raw.event_type || raw.eventType || \"event\",\n  severity: raw.severity || \"info\",\n  zone: raw.zone || \"\",\n  message: raw.message || raw.title || (\"MQTT \" + t.channel),\n  payload: { ...raw, mqtt_topic: msg.topic },\n  created_at: raw.created_at || new Date().toISOString()\n};\nif (t.channel === \"state\" && !raw.event_type) {\n  evt.event_type = \"state_update\";\n  evt.severity = \"info\";\n}\nmsg.payload = evt;\nmsg.headers = {\n  \"Content-Type\": \"application/json\",\n  \"X-TiSLY-Ingest-Secret\": env.get(\"INGEST_SECRET\") || \"\"\n};\nmsg.url = (env.get(\"TISLY_INGEST_URL\") || \"http://127.0.0.1:3080\") + \"/api/events/ingest\";\nreturn msg;",
        "outputs": 1,
        "x": 540,
        "y": 60,
        "wires": [["rd_debug_event", "rd_http_ingest", "rd_fn_future_notify"]]
    },
    {
        "id": "rd_fn_future_notify",
        "type": "function",
        "z": "rd_tab_main",
        "name": "将来: 通知分岐 (stub)",
        "func": "// Phase 121+: severity/alarm 時に Discord 直送など\nif (msg.payload && (msg.payload.severity === \"alarm\" || msg.payload.severity === \"critical\")) {\n  node.warn(\"[将来] 通知分岐: \" + msg.payload.event_type);\n}\nreturn null;",
        "outputs": 0,
        "x": 780,
        "y": 120,
        "wires": []
    },
    {
        "id": "rd_http_ingest",
        "type": "http request",
        "z": "rd_tab_main",
        "name": "POST ingest",
        "method": "POST",
        "ret": "obj",
        "paytoqs": "ignore",
        "url": "",
        "tls": "",
        "persist": false,
        "proxy": "",
        "insecureHTTPParser": false,
        "authType": "",
        "senderr": false,
        "headers": [],
        "x": 760,
        "y": 60,
        "wires": [["rd_switch_ingest_ok"]]
    },
    {
        "id": "rd_switch_ingest_ok",
        "type": "switch",
        "z": "rd_tab_main",
        "name": "ingest OK?",
        "property": "statusCode",
        "propertyType": "msg",
        "rules": [
            { "t": "btwn", "v": "200", "vt": "num", "v2": "299", "v2t": "num" }
        ],
        "checkall": "false",
        "repair": false,
        "outputs": 2,
        "x": 960,
        "y": 60,
        "wires": [["rd_debug_ok"], ["rd_fn_retry_queue"]]
    },
    {
        "id": "rd_fn_retry_queue",
        "type": "function",
        "z": "rd_tab_main",
        "name": "Retry queue (max 3)",
        "func": "const evt = msg.payload;\nconst key = \"retry_\" + (evt.event_id || msg._msgid);\nlet n = context.get(key) || 0;\nn++;\ncontext.set(key, n);\nif (n > 3) {\n  node.error(\"ingest failed after 3 retries: \" + JSON.stringify(msg.statusCode));\n  return [null, { payload: { failed: true, event: evt, status: msg.statusCode } }];\n}\nmsg.delay = n * 2000;\nreturn [msg, null];",
        "outputs": 2,
        "x": 1160,
        "y": 80,
        "wires": [["rd_delay_retry"], ["rd_debug_error"]]
    },
    {
        "id": "rd_delay_retry",
        "type": "delay",
        "z": "rd_tab_main",
        "name": "Backoff",
        "pauseType": "delayv",
        "timeout": "2",
        "timeoutUnits": "seconds",
        "rate": "1",
        "nbRateUnits": "1",
        "rateUnits": "second",
        "randomFirst": "1",
        "randomLast": "5",
        "randomUnits": "seconds",
        "drop": false,
        "allowrate": false,
        "outputs": 1,
        "x": 1340,
        "y": 60,
        "wires": [["rd_http_ingest"]]
    },
    {
        "id": "rd_fn_heartbeat_api",
        "type": "function",
        "z": "rd_tab_main",
        "name": "→ Heartbeat API",
        "func": "const t = msg.tisly;\nmsg.url = (env.get(\"TISLY_INGEST_URL\") || \"http://127.0.0.1:3080\") + \"/api/devices/\" + encodeURIComponent(t.device) + \"/heartbeat\";\nmsg.method = \"POST\";\nmsg.payload = { platform: \"mqtt\", raw: msg.payload };\nreturn msg;",
        "outputs": 1,
        "x": 540,
        "y": 140,
        "wires": [["rd_http_hb"]]
    },
    {
        "id": "rd_http_hb",
        "type": "http request",
        "z": "rd_tab_main",
        "name": "POST heartbeat",
        "method": "use",
        "ret": "obj",
        "paytoqs": "ignore",
        "url": "",
        "tls": "",
        "persist": false,
        "proxy": "",
        "insecureHTTPParser": false,
        "authType": "",
        "senderr": false,
        "headers": [],
        "x": 760,
        "y": 140,
        "wires": [["rd_debug_hb"]]
    },
    {
        "id": "rd_debug_event",
        "type": "debug",
        "z": "rd_tab_main",
        "name": "event → ingest",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": true,
        "complete": "payload.event_type",
        "targetType": "msg",
        "statusVal": "payload.severity",
        "statusType": "auto",
        "x": 760,
        "y": 20,
        "wires": []
    },
