    },
    {
        "id": "rd_debug_hb",
        "type": "debug",
        "z": "rd_tab_main",
        "name": "heartbeat",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": true,
        "complete": "tisly.device",
        "targetType": "msg",
        "statusVal": "statusCode",
        "statusType": "auto",
        "x": 960,
