# frozen_string_literal: true

# TiSLY iOS — App Store Connect API キーのみで署名・アップロード
# （手元 Mac / .p12 / .mobileprovision の GitHub Secrets は不要）
# CI 上の macos-latest が cert/sigh で証明書・プロファイルを自動取得する。

default_platform(:ios)

platform :ios do
  desc "Archive TiSLY iOS with ASC API key auth; optionally upload to TestFlight"
  lane :release do |options|
    workspace = options[:workspace] || "App.xcworkspace"
    scheme = options[:scheme] || "App"
    bundle_id = ENV.fetch("IOS_BUNDLE_ID", "jp.tisly.app")
    skip_upload =
      ENV["IOS_SKIP_UPLOAD"] == "1" ||
      [true, "true", "1"].include?(options[:skip_upload])

    # GitHub Actions 向け一時キーチェーン（ユーザーの .p12 は使わない）
    setup_ci if ENV["CI"]

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_PRIVATE_KEY"),
      is_key_content_base64: ENV["APP_STORE_PRIVATE_KEY_IS_BASE64"] == "1",
      duration: 1200,
      in_house: false
    )

    # Distribution 証明書を ASC API 経由で作成/取得し CI キーチェーンへ導入
    get_certificates(api_key: api_key)

    # App Store 用プロビジョニングプロファイルを ASC API 経由で作成/取得
    get_provisioning_profile(
      api_key: api_key,
      app_identifier: bundle_id
    )

    team_id =
      ENV["APPLE_TEAM_ID"].to_s.strip.empty? ? nil : ENV["APPLE_TEAM_ID"].to_s.strip
    team_id ||= ENV["FASTLANE_TEAM_ID"].to_s.strip
    team_id = nil if team_id.to_s.empty?

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "App.xcodeproj",
      team_id: team_id,
      code_sign_identity: "Apple Distribution",
      profile_name: ENV["SIGH_NAME"],
      bundle_identifier: bundle_id
    )

    build_app(
      workspace: workspace,
      scheme: scheme,
      configuration: "Release",
      clean: true,
      export_method: "app-store",
      export_options: {
        method: "app-store",
        signingStyle: "manual",
        provisioningProfiles: {
          bundle_id => ENV.fetch("SIGH_NAME")
        }
      },
      output_directory: "./build",
      output_name: "TiSLY",
      xcargs: team_id ? "DEVELOPMENT_TEAM=#{team_id}" : nil
    )

    if skip_upload
      UI.important("Skipping App Store Connect upload (IOS_SKIP_UPLOAD=1)")
      next
    end

    upload_to_testflight(
      api_key: api_key,
      ipa: "./build/TiSLY.ipa",
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )
  end
end
