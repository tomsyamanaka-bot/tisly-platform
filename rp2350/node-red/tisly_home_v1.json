        "group": "tisly_ui_grp_sys",
        "order": 3,
        "width": 12,
        "height": 1,
        "name": "アラーム",
        "label": "Alarm",
        "format": "{{msg.payload}}",
        "layout": "row-spread",
        "x": 620,
        "y": 460,
        "wires": []
    },
