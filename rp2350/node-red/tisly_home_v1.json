    {
        "id": "tisly_fn_route",
        "type": "function",
        "z": "tisly_tab_main",
        "name": "Route DI/RO → Dashboard",
        "func": "const topic = msg.topic || \"\";\nconst parts = topic.split(\"/\");\nif (parts.length < 4) return null;\nconst kind = parts[2];\nconst ch = parseInt(parts[3], 10);\nif (!ch || ch < 1 || ch > 8) return null;\nconst val = parseInt(String(msg.payload).trim(), 10);\nconst labels = {\n  di: [\"赤外①\",\"赤外②\",\"人感①\",\"人感②\",\"窓①\",\"窓②\",\"非常\",\"予備\"],\n  relay: [\"外灯①\",\"外灯②\",\"パトライト\",\"ブザー\",\"電光\",\"予備6\",\"予備7\",\"予備8\"]\n};\nif (kind === \"di\") {\n  msg.ui_update = { type: \"di\", ch, label: labels.di[ch-1], val };\n  return [msg, null];\n}\nif (kind === \"relay\") {\n  msg.ui_update = { type: \"relay\", ch, label: labels.relay[ch-1], val };\n  return [null, msg];\n}\nreturn null;",
        "outputs": 2,
        "x": 380,
        "y": 100,
        "wires": [["tisly_fn_di_ui"], ["tisly_fn_ro_ui"]]
    },
    {
        "id": "tisly_fn_di_ui",
        "type": "function",
        "z": "tisly_tab_main",
        "name": "DI → ui_text",
        "func": "const u = msg.ui_update;\nconst color = u.val ? \"#c62828\" : \"#2e7d32\";\nconst text = u.label + \": \" + (u.val ? \"検知\" : \"正常\");\nmsg.payload = \"<span style='font-size:18px;color:\"+color+\"'>\"+text+\"</span>\";\nconst outs = [[],[],[],[],[],[],[],[]];\nouts[u.ch-1] = [msg];\nreturn outs;",
        "outputs": 8,
        "x": 620,
        "y": 60,
        "wires": [
            ["tisly_ui_di1"], ["tisly_ui_di2"], ["tisly_ui_di3"], ["tisly_ui_di4"],
            ["tisly_ui_di5"], ["tisly_ui_di6"], ["tisly_ui_di7"], ["tisly_ui_di8"]
        ]
    },
    {
        "id": "tisly_fn_ro_ui",
        "type": "function",
        "z": "tisly_tab_main",
        "name": "RO → ui_text",
        "func": "const u = msg.ui_update;\nconst color = u.val ? \"#f9a825\" : \"#616161\";\nconst text = u.label + \": \" + (u.val ? \"ON\" : \"OFF\");\nmsg.payload = \"<span style='font-size:18px;color:\"+color+\"'>\"+text+\"</span>\";\nconst outs = [[],[],[],[],[],[],[],[]];\nouts[u.ch-1] = [msg];\nreturn outs;",
        "outputs": 8,
        "x": 620,
        "y": 160,
        "wires": [
            ["tisly_ui_ro1"], ["tisly_ui_ro2"], ["tisly_ui_ro3"], ["tisly_ui_ro4"],
            ["tisly_ui_ro5"], ["tisly_ui_ro6"], ["tisly_ui_ro7"], ["tisly_ui_ro8"]
        ]
    },
