    {
        "id": "tisly_fn_event_log",
        "type": "function",
        "z": "tisly_tab_main",
        "name": "Event log filter",
        "func": "if (msg.topic !== \"tisly/home/event\") return null;\nlet line;\ntry {\n  const o = typeof msg.payload === \"string\" ? JSON.parse(msg.payload) : msg.payload;\n  line = new Date().toISOString() + \" \" + JSON.stringify(o);\n} catch (e) {\n  line = new Date().toISOString() + \" \" + msg.payload;\n}\nmsg.payload = line + \"\\n\";\nreturn msg;",
        "outputs": 1,
        "x": 380,
        "y": 220,
        "wires": [["tisly_file_log", "tisly_ui_event", "tisly_fn_notify"]]
    },
    {
        "id": "tisly_file_log",
        "type": "file",
        "z": "tisly_tab_main",
        "name": "tisly_events.log",
        "filename": "/data/tisly_events.log",
        "appendNewline": true,
        "createDir": true,
        "overwriteFile": "false",
        "encoding": "utf8",
        "x": 620,
        "y": 200,
        "wires": []
    },
    {
        "id": "tisly_ui_event",
        "type": "ui_text",
        "z": "tisly_tab_main",
        "group": "tisly_ui_grp_sys",
        "order": 2,
        "width": 12,
        "height": 3,
        "name": "最新イベント",
        "label": "イベント",
        "format": "<pre style='font-size:12px'>{{msg.payload}}</pre>",
        "layout": "col-center",
        "x": 620,
        "y": 240,
        "wires": []
    },
    {
        "id": "tisly_fn_notify",
        "type": "function",
        "z": "tisly_tab_main",
        "name": "通知雛形",
        "func": "// TODO: LINE Notify / Email / Slack ノードへ接続\n// 例: 窓・非常のみ通知\nlet o;\ntry { o = JSON.parse(String(msg.payload).trim().split(\"\\n\")[0].split(\" \").slice(1).join(\" \") || msg.payload); } catch(e) { return null; }\nif (!o || !o.type) return null;\nconst urgent = [\"window\",\"emergency\"].includes(o.type);\nif (!urgent) return null;\nmsg.payload = \"【TiSLY】\" + (o.message || o.type);\nreturn msg;",
        "outputs": 1,
        "x": 620,
        "y": 280,
        "wires": [["tisly_debug_notify"]]
    },
    {
        "id": "tisly_debug_notify",
        "type": "debug",
        "z": "tisly_tab_main",
        "name": "通知（雛形→debug）",
        "active": true,
        "tosidebar": true,
        "console": false,
        "complete": "payload",
        "x": 860,
        "y": 280,
        "wires": []
    },
    {
        "id": "tisly_fn_heartbeat",
        "type": "function",
        "z": "tisly_tab_main",
        "name": "Heartbeat 更新",
        "func": "if (msg.topic !== \"tisly/home/heartbeat\") return null;\nflow.set(\"hb_last\", Date.now());\nlet o;\ntry { o = JSON.parse(msg.payload); } catch(e) { o = {}; }\nconst color = \"#2e7d32\";\nmsg.payload = \"<span style='font-size:18px;color:\"+color+\"'>通信正常 — uptime \" + (o.uptime||\"?\") + \"s</span>\";\nreturn msg;",
        "outputs": 1,
        "x": 380,
        "y": 340,
        "wires": [["tisly_ui_hb"]]
    },
    {
        "id": "tisly_inject_hb_check",
        "type": "inject",
        "z": "tisly_tab_main",
        "name": "HB check 30s",
        "props": [{"p": "payload"}],
        "repeat": "30",
        "crontab": "",
        "once": true,
        "onceDelay": 5,
        "topic": "",
        "payload": "",
        "payloadType": "date",
        "x": 150,
        "y": 400,
        "wires": [["tisly_fn_hb_watch"]]
    },
    {
        "id": "tisly_fn_hb_watch",
        "type": "function",
        "z": "tisly_tab_main",
        "name": "Heartbeat 監視",
        "func": "const last = flow.get(\"hb_last\") || 0;\nconst age = (Date.now() - last) / 1000;\nlet color, text;\nif (last === 0) {\n  color = \"#f9a825\"; text = \"待機中（未受信）\";\n} else if (age > 90) {\n  color = \"#c62828\"; text = \"異常 — \" + Math.round(age) + \"秒無応答\";\n} else if (age > 45) {\n  color = \"#f9a825\"; text = \"注意 — \" + Math.round(age) + \"秒\";\n} else {\n  color = \"#2e7d32\"; text = \"正常 — \" + Math.round(age) + \"秒前\";\n}\nmsg.payload = \"<span style='font-size:20px;color:\"+color+\"'>\" + text + \"</span>\";\nreturn msg;",
        "outputs": 1,
        "x": 380,
        "y": 400,
        "wires": [["tisly_ui_hb"]]
    },
    {
        "id": "tisly_ui_hb",
        "type": "ui_text",
        "z": "tisly_tab_main",
        "group": "tisly_ui_grp_sys",
        "order": 1,
        "width": 12,
        "height": 1,
        "name": "通信状態",
        "label": "Heartbeat",
        "format": "{{msg.payload}}",
        "layout": "row-spread",
        "x": 620,
        "y": 380,
        "wires": []
    },
    {
        "id": "tisly_fn_alarm",
        "type": "function",
        "z": "tisly_tab_main",
        "name": "アラーム監視",
        "func": "if (msg.topic !== \"tisly/home/alarm\") return null;\nlet o;\ntry { o = JSON.parse(msg.payload); } catch(e) { return null; }\nconst on = o.active === 1 || o.active === true;\nconst color = on ? \"#c62828\" : \"#2e7d32\";\nconst text = on ? \"アラーム発生中\" : \"通常\";\nmsg.payload = \"<span style='font-size:22px;font-weight:bold;color:\"+color+\"'>\"+text+\"</span>\";\nif (on) {\n  const n = { payload: \"【TiSLY】アラーム発生\", topic: \"alarm\" };\n  return [msg, n];\n}\nreturn [msg, null];",
        "outputs": 2,
        "x": 380,
        "y": 460,
        "wires": [["tisly_ui_alarm"], ["tisly_debug_notify"]]
    },
    {
        "id": "tisly_ui_alarm",
