;==============================================================================
; プロジェクト名 : TiSLY_HOME_Security_DEMO
; 用途           : TiSLY HOME Security DEMO（ホームセキュリティ展示）
; PLC            : 三菱電機 FX系列（FX3U / FX5U 等を想定）
; 開発環境       : GX Works2 / GX Works3
; 作成形式       : 命令リスト（ラダーへ転記・またはIL貼り付け用）
; バージョン     : 1.0.0
;==============================================================================
; 【I/O 割り当て】
;   入力  X0=警戒ON  X1=非常停止  X2=外周ビーム  X3=近接ビーム
;   出力  Y0=24V赤  Y1〜Y4=100V白×4
; 【内部】
;   M0=警戒中  M1=外周警報保持  M2=近接警報保持
;   M20=Y0駆動（二重コイル回避）  M10/M11=テンプレ拡張用予約
; 【クロック】M8013=1秒  M8012=0.1秒（PLC内蔵、プログラム不要）
;==============================================================================

;----- 段1：警戒ON保持 --------------------------------------------------------
; セレクタSW ON かつ 非常停止でない → 警戒中セット
0    LD     X000        ; X0 セレクタスイッチ / 警戒ON
     ANI    X001        ; X1 非常停止でない（NC接点の場合は配線に合わせ要確認）
     SET    M000        ; M0 警戒中

;----- 段2：警戒OFFリセット ---------------------------------------------------
; 警戒OFF → 内部状態・警報保持をすべて解除
     LDI    X000        ; X0 OFF
     RST    M000        ; M0 警戒中
     RST    M001        ; M1 センサー1警報保持
     RST    M002        ; M2 センサー2警報保持

;----- 段3：非常停止 ----------------------------------------------------------
; 非常停止ON → 内部リレー・全出力を強制OFF
     LD     X001        ; X1 非常停止ボタン
     RST    M000
     RST    M001
     RST    M002
     RST    Y000        ; Y0 24V赤ライト
     RST    Y001        ; Y1 100V白1
     RST    Y002        ; Y2 100V白2
     RST    Y003        ; Y3 100V白3
     RST    Y004        ; Y4 100V白4

;----- 段4：センサー1警報保持（外周検知）--------------------------------------
     LD     M000        ; M0 警戒中
     AND    X002        ; X2 ビームセンサー1 / 外周検知
     SET    M001        ; M1 外周警報ラッチ

;----- 段5：センサー2警報保持（近接検知）--------------------------------------
     LD     M000        ; M0 警戒中
     AND    X003        ; X3 ビームセンサー2 / 近接検知
     SET    M002        ; M2 近接警報ラッチ

;----- 段6：Y0赤ライト制御（M20経由・二重コイルなし）--------------------------
; 優先度: M2近接警報時は0.1s高速点滅 > M0警戒中は1s低速点滅
     LD     M002        ; M2 ON → 高速点滅優先
     AND    M8012       ; 0.1秒クロック
     LD     M000        ; M0 警戒中
     ANI    M002        ; M2 OFF時のみ低速へ
     AND    M8013       ; 1秒クロック
     ORB
     OUT    M020        ; M20 Y0駆動指令（内部）

     LD     M020
     OUT    Y000        ; Y0 24V赤ライト（単一コイル）

;----- 段7：Y1 白ライト1（外周警報：常時点灯）--------------------------------
     LD     M001
     OUT    Y001

;----- 段8：Y2 白ライト2（外周警報：1秒点滅）----------------------------------
     LD     M001
     AND    M8013
     OUT    Y002

;----- 段9：Y3 白ライト3（近接警報：常時点灯）---------------------------------
     LD     M002
     OUT    Y003

;----- 段10：Y4 白ライト4（近接警報：常時点灯）--------------------------------
     LD     M002
     OUT    Y004

     END
