;==============================================================================
; プロジェクト名 : TiSLY_HOME_Security_DEMO
; 用途           : TiSLY HOME Security デモ用 PLC ラダープログラム
; PLC 想定       : 三菱 FX 系 (FX3U / FX5U 等) / GX Works2 / GX Works3
; 作成           : TiSLY 標準テンプレート化前提
;==============================================================================
; I/O 割り当て
;   入力 : X0=警戒ON  X1=非常停止  X2=外周検知  X3=近接検知
;   出力 : Y0=24V赤  Y1〜Y4=100V白×4
;   内部 : M0=警戒中  M1=センサー1警報  M2=センサー2警報  M20=Y0制御
;   クロック : M8013=1秒  M8012=0.1秒
;==============================================================================

; ----- 段1：警戒 ON 保持 -----
; X0 ON かつ 非常停止でない → M0 SET
0    LD     X0          ; セレクタスイッチ / 警戒 ON
     ANI    X1          ; 非常停止でないこと
     SET    M0          ; 警戒中 SET（保持）

; ----- 段2：警戒 OFF リセット -----
; X0 OFF → M0/M1/M2 リセット（全出力は下位段で自動 OFF）
7    LDI    X0          ; セレクタスイッチ OFF
     RST    M0          ; 警戒中 解除
     RST    M1          ; センサー1警報 解除
     RST    M2          ; センサー2警報 解除

; ----- 段3：非常停止 -----
; X1 ON → M0/M1/M2 リセット、Y0〜Y4 すべて OFF（段6より前に配置）
14   LD     X1          ; 非常停止ボタン ON
     RST    M0          ; 警戒中 解除
     RST    M1          ; センサー1警報 解除
     RST    M2          ; センサー2警報 解除
     RST    Y0          ; 24V 赤ライト OFF
     RST    Y1          ; 100V 白ライト1 OFF
     RST    Y2          ; 100V 白ライト2 OFF
     RST    Y3          ; 100V 白ライト3 OFF
     RST    Y4          ; 100V 白ライト4 OFF

; ----- 段4：センサー1 警報保持 -----
; M0 警戒中 かつ X2 ON → M1 SET
21   LD     M0          ; 警戒中
     AND    X2          ; ビームセンサー1 / 外周検知
     SET    M1          ; センサー1警報 保持 SET

; ----- 段5：センサー2 警報保持 -----
; M0 警戒中 かつ X3 ON → M2 SET
28   LD     M0          ; 警戒中
     AND    X3          ; ビームセンサー2 / 近接検知
     SET    M2          ; センサー2警報 保持 SET

; ----- 段6：Y0 赤ライト制御（内部リレー M20 経由・単一コイル構成） -----
; 優先度 : M2 ON 時は M8012 高速点滅 / それ以外 M0 中は M8013 低速点滅
; ※ Y0 への二重コイルを避けるため M20 で集約
35   LD     M2          ; 近接警報中 → 高速点滅優先
     AND    M8012       ; 0.1秒クロック
     LD     M0          ; 警戒中（低速点滅側）
     ANI    M2          ; M2 非成立時のみ低速側有効
     AND    M8013       ; 1秒クロック
     ORB                ; 高速 / 低速 いずれか成立
     OUT    M20          ; Y0 制御内部リレー

42   LD     M20         ; M20 経由で Y0 を単一コイル出力
     OUT    Y0          ; 24V 赤ライト

; ----- 段7：Y1 白ライト1 -----
; M1 ON → Y1 点灯
49   LD     M1          ; センサー1警報保持
     OUT    Y1          ; 100V 白ライト1 常時点灯

; ----- 段8：Y2 白ライト2 -----
; M1 ON かつ M8013 → Y2 点滅
56   LD     M1          ; センサー1警報保持
     AND    M8013       ; 1秒クロック
     OUT    Y2          ; 100V 白ライト2 点滅

; ----- 段9：Y3 白ライト3 -----
; M2 ON → Y3 点灯
63   LD     M2          ; センサー2警報保持
     OUT    Y3          ; 100V 白ライト3 常時点灯

; ----- 段10：Y4 白ライト4 -----
; M2 ON → Y4 点灯
70   LD     M2          ; センサー2警報保持
     OUT    Y4          ; 100V 白ライト4 常時点灯

; ----- プログラム終了 -----
77   END
