# TiSLY Print Models API（スマホ 3D ビューワーへアップロード）
# TISLY_PRINT_API_URL=http://127.0.0.1:3080/api/print-models/v1/upload
# TISLY_PRINT_API_URL=https://tisly.jp/api/print-models/v1/upload
# TISLY_PRINT_UPLOAD_TOKEN=
# TISLY_UPLOAD_GCODE=false

# ---------------------------------------------------------------------------
# 3Dプリンター自動着火（OctoPrint / Moonraker）
# 秘密情報は本ファイルを .env にコピーして記入。絶対に git commit しないこと。
# ---------------------------------------------------------------------------

# ベース URL（末尾スラッシュ不要）
# OctoPrint 例:  http://192.168.1.50:5000
# Moonraker 例:  http://192.168.1.50:7125
PRINTER_API_URL=

# API Key（OctoPrint: 設定 → API。Moonraker: 認証有効時のみ）
PRINTER_API_KEY=
# 別名（どちらか一方で可）
# OCTOPRINT_API_KEY=
# MOONRAKER_API_KEY=

# octoprint | moonraker | auto（URL から推定）
PRINTER_BACKEND=auto

# アップロード成功後に印刷開始するか（既定 true）
PRINTER_AUTO_START=true

# true のとき実際の HTTP を送らず、設定・パスのみ検証
PRINTER_DRY_RUN=false

# https 自己署名証明書を許す場合は false
PRINTER_VERIFY_SSL=true

# 任意: gcodes 配下のサブフォルダ名など
# PRINTER_ID=

# 任意: アップロード時 print=true に加え、別途 start コマンドを強制
# PRINTER_FORCE_JOB_START=false
