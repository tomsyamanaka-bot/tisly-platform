# TiSLY — tisly.jp 本番用 .env テンプレート（Phase 1381–1400 完全版）
# 使い方: cp .env.production.example .env.production → 値を編集 → VPS では .env として配置
# 秘密情報は git にコミットしないこと

# --- 必須（公開前に必ず設定） ---
NODE_ENV=production
TISLY_PUBLIC_URL=https://tisly.jp

JWT_SECRET=
ADMIN_PASSWORD_HASH=

# DB（初回は sqlite、本番安定後 postgres 推奨）
DB_PROVIDER=sqlite
POSTGRES_URL=

# MQTT（VPS 内部ブローカー — 外部公開しない）
MQTT_URL=
MQTT_USERNAME=
MQTT_PASSWORD=

# --- サーバー ---
PORT=3080
TISLY_PORT=3080
TISLY_HOST=0.0.0.0
TISLY_DB_PATH=./data/tisly_notifications.db

TISLY_DEMO_MODE=false
DEMO_RESET_ENABLED=false

# 認証
ADMIN_USERNAME=admin
INGEST_SECRET=
DEPLOY_OPS_TOKEN=

# 初回公開は mock 維持（営業デモ安全）
GMAIL_SEND_MODE=mock
NOTIFICATION_EMAIL_MODE=mock
GOOGLE_OAUTH_ENABLED=false

# Gmail SMTP（通知メール — アプリパスワード方式）
# real 運用時: GMAIL_SEND_MODE=real + NOTIFICATION_EMAIL_MODE=gmail + SMTP_PASS を設定
# SMTP_PASS は git にコミットしないこと
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFICATION_TEST_TO=
QNAP_UPLOAD_MODE=mock
QNAP_MODE=mock
MQTT_MODE=mock
MQTT_MOCK_MODE=true
MQTT_SUBSCRIBER_ENABLED=false
SHELLY_MODE=mock

# Lock Provider（Phase 1361–1380 — 初回は switchbot + mock mode）
LOCK_PROVIDER=switchbot

# SwitchBot Lock + Security Automation（Phase 1321–1360 — 初回は mock）
#
# TiSLY HOME（/api/home/v1/*）は SWITCHBOT_MODE を見ない。
# TOKEN と SECRET が両方入った時点で自動的に実機モードになり、
# 空のままなら VPS 本番でもモックのまま安全に動く。
# 現在の判定は GET /api/home/v1/switchbot-status で確認できる。
# デバイスIDは `npm run switchbot:list-devices` で取得する。
SWITCHBOT_MODE=mock
SWITCHBOT_TOKEN=
SWITCHBOT_SECRET=
# 玄関スマートロック（例: DD:17:1E:46:4C:99）
SWITCHBOT_LOCK_DEVICE_ID=
# 赤外線エアコン（Hub 経由の仮想リモコンID）
SWITCHBOT_AIR_CONDITIONER_DEVICE_ID=
SWITCHBOT_AUTO_ARM_ENABLED=false
SWITCHBOT_AUTO_DISARM_ENABLED=false
SWITCHBOT_POLL_INTERVAL_MS=30000
SWITCHBOT_WORKER_ENABLED=true
SECURITY_EVENT_LOG_ENABLED=true
SECURITY_UNKNOWN_DEVICE_POLICY=block_auto_arm
SECURITY_UNLOCK_COOLDOWN_SEC=120
SECURITY_FOCUS_CUSTOMER_CODE=TOMS001

# Rate limit / DB（VPS 初回は memory + sqlite で可）
RATE_LIMIT_PROVIDER=memory

# --- real 接続時にコメント解除・設定 ---
# MQTT_URL=mqtt://127.0.0.1:1883

# Remote Test PoC (/remote-test) — Phase 2
# Generate: openssl rand -hex 16
REMOTE_TEST_TOKEN=
DISCORD_WEBHOOK_URL=
# MQTT_USERNAME=tisly_mqtt
# MQTT_PASSWORD=
# MQTT_SUBSCRIBER_ENABLED=true
# MQTT_MOCK_MODE=false

# SHELLY_BASE_URL=http://192.168.1.100
# SHELLY_AUTH_TOKEN=

# QNAP_WEBDAV_URL=https://nas.example.local:5006/TOMS
# QNAP_USERNAME=
# QNAP_PASSWORD=

# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://tisly.jp/business/settings
# GOOGLE_REFRESH_TOKEN=

# postgres 移行時
# DB_PROVIDER=postgres
# POSTGRES_URL=postgresql://tisly:pass@127.0.0.1:5432/tisly
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432
# POSTGRES_DB=tisly
# POSTGRES_USER=tisly
# POSTGRES_PASSWORD=

# --- Google Calendar / Maps（日程 v1）---
# GOOGLE_CALENDAR_ENABLED=true
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://tisly.jp/auth/google/callback
# GOOGLE_MAPS_API_KEY=  # Directions API 有効化済みキー（未設定時 Maps API false）

# 現調スケッチ壁輪郭 Vision（Gemini）
# 未設定時は mock プロバイダ（固定ダミー SVG）
# GEMINI_API_KEY=
# SURVEY_SKETCH_AI_SVG_PROVIDER=auto
# DISPATCH_DEFAULT_ORIGIN=事務所（守谷市）
# OPEN_METEO_LIVE=1

# --- 見積・請求 PDF（日本語レンダリング）---
# TISLY_PDF_PUPPETEER=true
