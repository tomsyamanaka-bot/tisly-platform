# TiSLY Notification Platform

# Phase 61-80 営業デモ（npm run demo で自動設定）
# TISLY_DEMO_MODE=true
# DEMO_MODE=true
# TISLY_DEMO_AUTO_START=true — production template (do NOT commit real .env)
# DEVICE_HEARTBEAT_WARN_SEC=300
# DEVICE_HEARTBEAT_OFFLINE_SEC=900

NODE_ENV=development
TISLY_PORT=3080
TISLY_HOST=0.0.0.0
TISLY_PUBLIC_URL=https://tisly.jp
TISLY_DB_PATH=./data/tisly_notifications.db

# Aliases (optional; TISLY_* takes precedence when both set)
PORT=3080
PUBLIC_BASE_URL=https://tisly.jp
DATABASE_URL=sqlite://./data/tisly_notifications.db

MQTT_URL=mqtt://127.0.0.1:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=tisly/#
MQTT_CLIENT_ID=tisly-notification-core

# 本番前は docs/manual-setup-required.md を参照（開発時は DUMMY_* 可）
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@tisly.jp
# Auto-setup: npm run vapid:setup  (see docs/vapid_env_setup.md)

DISCORD_WEBHOOK_URL=
# Optional — platform notifications only; Remote Test uses Web Push

# Remote Test PoC (/remote-test) — PWA + Web Push
# Generate: openssl rand -hex 16
REMOTE_TEST_TOKEN=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_PASSWORD=
SMTP_FROM=noreply@tisly.jp
ADMIN_EMAIL=

DEFAULT_TENANT_ID=default

# Node-RED HTTP ingest (shared secret)
INGEST_SECRET=change-me-before-production

# Admin JWT auth (Phase 161-180 — required for management APIs)
JWT_SECRET=change-me-use-openssl-rand-hex-32
ADMIN_USERNAME=admin
# Generate: node -e "import('./dist/auth/password.js').then(m=>console.log(m.hashPassword('your-password')))"
ADMIN_PASSWORD_HASH=
SESSION_EXPIRES_MINUTES=480

# Database provider (Phase 201-220)
DB_PROVIDER=sqlite
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432
# POSTGRES_DB=tisly
# POSTGRES_USER=tisly
# POSTGRES_PASSWORD=
# POSTGRES_SSL=false
# DATABASE_URL=postgresql://tisly:pass@127.0.0.1:5432/tisly

# Rate limit / cache / replay — memory (default) | redis
RATE_LIMIT_PROVIDER=memory
# REDIS_URL=redis://127.0.0.1:6379

# Admin 2FA (Phase 211-215) — otplib + QR
# REQUIRE_2FA=true
# TV_CERT_PINNING_ENABLED=false

# SIEM provider: none | loki | elastic | syslog
SIEM_PROVIDER=none
# SIEM_LOKI_URL=http://127.0.0.1:3100
# SIEM_ELASTIC_URL=http://127.0.0.1:9200
# SIEM_ELASTIC_INDEX=tisly-security
# SIEM_SYSLOG_HOST=127.0.0.1
# SIEM_SYSLOG_PORT=514

# VPS / Node-RED labels (Infrastructure tab)
# VPS_LABEL=ConoHa VPS
# NODE_RED_URL=http://127.0.0.1:1880

# Event signature & replay (Phase 181-200)
# SIGNATURE_CHECK_ENABLED=false — set true to require HMAC on all ingest
# REPLAY_PROTECTION_ENABLED=true
# SIEM_EXPORT_ENABLED=true
# SIGNATURE_MAX_AGE_SEC=300

# Optional scheduled backup (local data/backups)
BACKUP_SCHEDULER_ENABLED=false
BACKUP_INTERVAL_HOURS=24

HEARTBEAT_WARN_SEC=30
HEARTBEAT_ALARM_SEC=300

# MQTT subscriber (Phase 121-140) — production: MQTT_SUBSCRIBER_ENABLED=true
# MQTT_MOCK_MODE=true — heartbeat mock without broker
MQTT_SUBSCRIBER_ENABLED=false
MQTT_MOCK_MODE=true
# Phase 781-820 — MQTT TLS + client certificate (paths unset → safe mock fallback)
MQTT_TLS_ENABLED=false
# MQTT_CA_PATH=./certs/mqtt-ca.pem
# MQTT_CERT_PATH=./certs/mqtt-client.crt
# MQTT_KEY_PATH=./certs/mqtt-client.key
# MQTT_TLS_REJECT_UNAUTHORIZED=true
# LIVE_OPS_MOCK_PUSH=false — stop 12s WebSocket mock push when MQTT real
# LIVE_OPS_MOCK_PUSH=true
# GMAIL_QUEUE_MAX_ATTEMPTS=3

# QNAP SMB archive (Phase 141-160 RC1)
# mock = local data/qnap-archive only | real = SMB when credentials set
QNAP_MODE=mock
# Knowledge Field UX V4 — mock | webdav（webdav 未設定時は自動 mock fallback）
# QNAP_MODE=webdav
QNAP_HOST=
QNAP_SHARE=TiSLY
# Knowledge Field / MotherShip パス（認証情報はコミットしない）
# QNAP_WEBDAV_BASE_URL=https://192.168.1.10:5006/TiSLY
# QNAP_FILESTATION_BASE_URL=http://192.168.1.10/cgi-bin/filemanager/
# QNAP_SHARE_ROOT=TiSLY
# QNAP_SMB_ROOT=\\192.168.1.10\TiSLY
QNAP_USERNAME=
QNAP_PASSWORD=
QNAP_BASE_PATH=/TiSLY

# Phase 221-240 PRO Remote — demo customer portal passwords
CUSTOMER_DEMO_PASSWORD=demo-remote-2026

# Phase 241-260 — customer login lockout
CUSTOMER_LOGIN_LOCK_MINUTES=15
CUSTOMER_LOGIN_MAX_ATTEMPTS=5

# TV certificate pinning (placeholder until production cert)
TV_CERT_PINNING_ENABLED=false
TV_CERT_FINGERPRINT=sha256/PLACEHOLDER_REPLACE_BEFORE_PRODUCTION

# Phase 301-320 — Stripe Billing (mock OK when unset)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_LITE=price_...
# STRIPE_PRICE_STANDARD=price_...
# STRIPE_PRICE_PRO=price_...
# STRIPE_PRICE_PRO_REMOTE=price_...

# Phase 1361-1380 — Lock Provider (switchbot | sesame | mock)
LOCK_PROVIDER=switchbot

# Phase 1321-1360 — SwitchBot Lock + Security Automation
SWITCHBOT_MODE=mock
SWITCHBOT_TOKEN=
SWITCHBOT_SECRET=
SWITCHBOT_LOCK_DEVICE_ID=
SWITCHBOT_AUTO_ARM_ENABLED=false
SWITCHBOT_AUTO_DISARM_ENABLED=false
SWITCHBOT_POLL_INTERVAL_MS=30000
SWITCHBOT_WORKER_ENABLED=true
SECURITY_EVENT_LOG_ENABLED=true
SECURITY_UNKNOWN_DEVICE_POLICY=block_auto_arm
SECURITY_UNLOCK_COOLDOWN_SEC=120
SECURITY_FOCUS_CUSTOMER_CODE=TOMS001

# Phase 401-420 — Field live device connection (installer PWA)
FIELD_LIVE_MODE=false
MQTT_ACK_REQUIRED=false
CERT_PROVISIONING_MODE=mock

# Install photo storage (Phase 381-400)
STORAGE_PROVIDER=local
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_BUCKET=tisly-install-photos
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# PDF — optional puppeteer (npm install puppeteer)
# TISLY_PDF_PUPPETEER=true

# Phase 561-580 — TOMS Business production integration
# Phase 581-600 — real integration (see docs/phase581_600_status.md)
GOOGLE_OAUTH_ENABLED=false
# mock | dryRun | real — real requires GOOGLE_OAUTH_ENABLED=true and UI confirmed=true
GMAIL_SEND_MODE=mock
# 営業メール連携用（日程カレンダーとは別 OAuth フロー）
GOOGLE_REFRESH_TOKEN=
BUSINESS_MAIL_TO=toms.yamanaka@gmail.com
QNAP_UPLOAD_MODE=mock
# QNAP WebDAV 実保存 v1（storage_documents_v1 手動同期）
QNAP_WEBDAV_URL=
QNAP_WEBDAV_USER=
QNAP_WEBDAV_PASSWORD=
# Tailscale / オレオレ証明書 QNAP 向け（100.x.x.x は未設定時も自動許容）
# QNAP_WEBDAV_TLS_INSECURE=true
QNAP_BASE_DIR=/TiSLY
# 互換エイリアス
QNAP_USERNAME=
QNAP_PASSWORD=
QNAP_BASE_PATH=/TiSLY

# Storage settings UI — ローカル開発で実 NAS なしのとき mock 接続テスト
# QNAP_STORAGE_MOCK=true
# 見積一覧の QNAP保存は常に実機 WebDAV（モックミラー不可）
# 接続解決順: QNAP_WEBDAV_*（最優先）→ /storage-settings-v1 → QNAP_HOST / QNAP_LOCAL_HOST
# QNAP_WEBDAV_URL=https://192.168.1.10:5006/TiSLY
# QNAP_WEBDAV_USER=...
# QNAP_WEBDAV_PASSWORD=...
# または QNAP_HOST + QNAP_USERNAME + QNAP_PASSWORD
# 書類保存用 NAS (nastoms) — 見積書・請求書のローカル Wi-Fi 既定宛先
QNAP_LOCAL_HOST=192.168.1.134
QNAP_LOCAL_PORT=5522
# 任意: フル URL 指定時は host/port より優先
# QNAP_LOCAL_WEBDAV_URL=http://192.168.1.134:5522/TiSLY
# ENV 設定時はストレージ UI のモックミラーも無効: QNAP_STORAGE_FORCE_REAL=true
TOMS_COMPANY_NAME=株式会社 TOMS
TOMS_COMPANY_POSTAL=302-0102
TOMS_COMPANY_ADDRESS=茨城県守谷市松前台7丁目24番地9
TOMS_COMPANY_PHONE=080-2710-4483
TOMS_REPRESENTATIVE_NAME=山中 智紀
TOMS_COMPANY_EMAIL=
TOMS_LOGO_URL=/assets/toms-logo-placeholder.svg
TOMS_REGISTRATION_NO=T-2030001139320
TOMS_BANK_INFO=みずほ銀行 守谷支店 普通 1234567 カ）トムズ

# 日程調整 — Google Calendar OAuth（false=モック予定 / true=本番カレンダー）
# 手順: docs/google_calendar_practical_pwa.md
# Google Cloud: Calendar API 有効化 + リダイレクト URI 登録
#   本番: https://tisly.jp/auth/google/callback
#   ローカル: http://localhost:3080/auth/google/callback
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://tisly.jp/auth/google/callback
# 省略可 — 未設定時は https://www.googleapis.com/auth/calendar
# GOOGLE_CALENDAR_SCOPES=https://www.googleapis.com/auth/calendar
# 互換エイリアス（上記 GOOGLE_* 未設定時のみ使用）
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=https://tisly.jp/auth/google/callback
# 本番 VPS .env 例（シークレットはリポジトリにコミットしない）:
# GOOGLE_CALENDAR_ENABLED=true
# GOOGLE_CLIENT_ID=<OAuthクライアントID>.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-<secret>
# GOOGLE_REDIRECT_URI=https://tisly.jp/auth/google/callback

# 配車表 — Google Maps Directions（人間が取得）
GOOGLE_MAPS_API_KEY=
# 移動時間の起点（未設定時: 事務所（守谷市））
# DISPATCH_DEFAULT_ORIGIN=事務所（守谷市）

# 現調スケッチ壁輪郭 Vision（Gemini）
# 未設定時は mock プロバイダ（固定ダミー SVG）
GEMINI_API_KEY=
# GEMINI_SKETCH_MODEL=gemini-3.6-flash
# GEMINI_ESTIMATE_LINE_MODEL=gemini-3.6-flash
# auto | mock | gemini（auto=キー有無で切替）
# SURVEY_SKETCH_AI_SVG_PROVIDER=auto

# 天気 — Open-Meteo はキー不要。本接続時は OPEN_METEO_LIVE=1
OPEN_METEO_LIVE=0

# Background workers (notification / webhook / report email)
# WORKERS_ENABLED=true
# WORKER_INTERVAL_MS=15000
