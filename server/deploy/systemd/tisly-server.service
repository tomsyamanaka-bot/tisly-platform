[Unit]
Description=TiSLY Notification Platform API and PWA
After=network.target mosquitto.service
Wants=mosquitto.service

[Service]
Type=simple
WorkingDirectory=/opt/tisly/server
EnvironmentFile=/opt/tisly/server/.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node dist/index.js
# デプロイ中断・一時クラッシュ後も自動復帰（502 長期化を防ぐ）
Restart=always
RestartSec=3
StartLimitIntervalSec=60
StartLimitBurst=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tisly-server

[Install]
WantedBy=multi-user.target
