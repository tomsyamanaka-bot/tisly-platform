# TiSLY Remote Test PoC — PWA / Web Push 最小設定
# 使い方: cp .env.sample .env → 値を記入 → npm run vapid:setup → systemctl restart tisly-server
# 秘密情報は git にコミットしないこと

# 通信PoC 認証トークン（Web UI / RP2350 と同じ値）
# 生成: openssl rand -hex 16
REMOTE_TEST_TOKEN=

# Web Push（必須 — iPhone PWA 通知）
# 自動設定: npm run vapid:setup
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@tisly.jp
